{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "account_id": "60387d55b30e91f155c48f0e8bcbd15a",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://photo-be-drja.onrender.com"
  },
  // Keeps the free Render server awake 06:00–01:00 Vietnam time (see scheduled() in worker.js).
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
