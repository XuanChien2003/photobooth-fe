{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photobooth",
  "account_id": "8b23802c92443c22e78e245ca164e662",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://photobooth-be-5ngq.onrender.com"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}