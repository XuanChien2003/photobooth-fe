{
  "name": "nxc-fe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-canon-agent.mjs && vite build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler@4 deploy",
    "deploy:studio": "npm run build:cloudflare && npx wrangler@4 deploy --config wrangler.studio.jsonc",
    "preview:cloudflare": "npx wrangler@4 dev",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "camera:agent": "node scripts/canon-camera/server.js"
  },
  "dependencies": {
    "@fontsource/patrick-hand": "5.1.1",
    "@fontsource/playfair-display": "5.1.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.0"
  }
}
