      "html": "<button class=\"ds-frame\" aria-pressed=\"true\"><span class=\"ds-frame-preview\"><svg width=\"126\" height=\"150\" viewBox=\"0 0 126 150\" aria-hidden=\"true\"><rect x=\"2\" y=\"1\" width=\"55\" height=\"148\" fill=\"#fff\"/><rect x=\"69\" y=\"1\" width=\"55\" height=\"148\" fill=\"#fff\"/><path d=\"M8 12h43v35H8zM8 57h43v35H8zM8 102h43v35H8zM75 12h43v35H75zM75 57h43v35H75zM75 102h43v35H75z\" fill=\"var(--stone,#eee8df)\"/></svg></span><span class=\"ds-frame-title\">Bộ khung<span class=\"ds-frame-check\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></span></button>",
      "css": ".ds-frame{font-family:var(--sans,\"Be Vietnam Pro\",\"Segoe UI\",sans-serif);display:grid;gap:12px;width:220px;padding:0;border:0;border-radius:0;background:transparent;color:var(--ink,#302822);cursor:pointer}.ds-frame-preview{display:flex;align-items:center;justify-content:center;aspect-ratio:1.1;padding:24px 18px;border:2px solid var(--wine,#4b332a);border-radius:14px;background:var(--stone,#eee8df);transition:border-color 180ms}.ds-frame-title{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:17px;font-weight:600;line-height:1.4}.ds-frame-check{display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:6px;background:var(--wine,#4b332a);color:#fff}.ds-frame:hover .ds-frame-preview,.ds-frame:active .ds-frame-preview{border-color:var(--wine,#4b332a)}.ds-frame:focus-visible{outline:2px solid var(--wine,#4b332a);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-frame-preview{transition:none}}"
